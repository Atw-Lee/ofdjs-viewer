{
  "name": "@ofdjs/viewer",
  "version": "0.1.0",
  "description": "Browser-native OFD parser, Canvas renderer and React viewer",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": ["ofd", "canvas", "react", "viewer", "document"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atw-Lee/ofdjs-viewer.git"
  },
  "homepage": "https://github.com/Atw-Lee/ofdjs-viewer#readme",
  "bugs": {
    "url": "https://github.com/Atw-Lee/ofdjs-viewer/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/style.css": "./dist/react/style.css",
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/browser/ofdjs.js"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.build.json && cp src/react/style.css dist/react/style.css && vite build --config vite.lib.config.ts",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "sample": "node scripts/sample.mjs",
    "prepack": "npm run build",
    "pretest:browser": "npm run build"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "license": "MIT"
}
